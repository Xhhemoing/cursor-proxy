{
  "host": "0.0.0.0",
  "port": 8800,
  "api_keys": [
    {
      "key": "CHANGE_ME_API_KEY",
      "name": "客户示例",
      "tags": ["vip", "项目A"],
      "sales_id": "alice"
    }
  ],
  "backend": "https://api2.cursor.sh",
  "timeout_s": 1800,
  "log_file": "proxy.log",
  "default_model": "kimi-k3",
  "max_concurrency_per_account": 5,
  "acquire_wait_ms": 5000,
  "admin_token": "CHANGE_ME_ADMIN_TOKEN",
  "billing": {
    "db_file": "billing.db",
    "tz_offset_minutes": 480,
    "currency": "RMB",
    "default_commission_bps": 0,
    "reject_unpriced": false,
    "prices": [
      { "model": "kimi-k3", "input_per_m": 1.0, "output_per_m": 4.0, "cache_read_per_m": 0.1, "note": "1M 窗口 RMB/1M tokens" },
      { "model": "kimi-k3-*", "input_per_m": 1.0, "output_per_m": 4.0, "cache_read_per_m": 0.1 },
      { "model": "claude-sonnet-4-6", "input_per_m": 3.0, "output_per_m": 15.0 },
      { "model": "claude-opus-*", "input_per_m": 15.0, "output_per_m": 75.0 },
      { "model": "*", "input_per_m": 1.0, "output_per_m": 2.0, "note": "兜底价" }
    ],
    "sales": [
      { "id": "alice", "name": "Alice", "commission_bps": 1500 }
    ]
  },
  "proxy": {
    "enabled": false,
    "require_proxy": false,
    "default_mode": "hash",
    "probe_interval_s": 60,
    "probe_timeout_ms": 8000,
    "fail_threshold": 3,
    "nodes": [
      {
        "id": "us-1",
        "url": "http://user:pass@1.2.3.4:8080",
        "kind": "http",
        "region": "us",
        "tags": ["residential"],
        "enabled": true,
        "max_accounts": 0,
        "note": "示例, 勿提交真实密码"
      }
    ],
    "rules": [
      {
        "id": "vip-us",
        "enabled": true,
        "account_prefix": "",
        "account_tags": ["vip"],
        "proxy_tags": ["residential"],
        "region": "us",
        "mode": "hash",
        "priority": 10
      }
    ]
  }
}
